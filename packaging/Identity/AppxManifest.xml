<?xml version="1.0" encoding="utf-8"?>
<!--
  FluxKit's identity package: a "sparse" package that gives the normal, unpackaged FluxKit.exe a package identity,
  which Windows requires before an app may read notifications (the userNotificationListener capability). It contains
  no app files: AllowExternalContent points Windows at the folder FluxKit already runs from.
  Development: registered unsigned in Developer Mode (scripts/make-identity.ps1 -Register).
  Release: packed with MakeAppx and signed with a real certificate.
  The Publisher, Name and Application Id must match the <msix> element in src/FluxKit.App/app.manifest.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="FluxKit.Identity" Publisher="CN=FluxKit Dev" Version="1.0.0.0" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>FluxKit</DisplayName>
    <PublisherDisplayName>FluxKit contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
  <Applications>
    <Application
      Id="FluxKit"
      Executable="FluxKit.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="FluxKit"
        Description="Small tools that make Windows easier to use."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
