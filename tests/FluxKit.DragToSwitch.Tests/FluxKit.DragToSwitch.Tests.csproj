<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(FluxWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(FluxMinWindows)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(FluxMinWindows)</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1861;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\FluxKit.Utilities.DragToSwitch\FluxKit.Utilities.DragToSwitch.csproj" />
  </ItemGroup>
</Project>
