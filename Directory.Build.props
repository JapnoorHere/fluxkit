<Project>
  <!-- Shared build settings for every FluxKit project. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Product>FluxKit</Product>
    <Company>FluxKit contributors</Company>
    <Copyright>© 2026 FluxKit contributors</Copyright>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>

    <!-- Shared Windows target for every Windows-specific project. -->
    <FluxWindowsTfm>net10.0-windows10.0.26100.0</FluxWindowsTfm>
    <FluxMinWindows>10.0.22621.0</FluxMinWindows>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
