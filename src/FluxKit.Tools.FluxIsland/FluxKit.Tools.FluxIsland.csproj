<Project Sdk="Microsoft.NET.Sdk">
  <!-- Flux Island tool: what the island shows and when. No XAML (views live in the App). -->
  <PropertyGroup>
    <TargetFramework>$(FluxWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(FluxMinWindows)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(FluxMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>FluxKit.Tools.FluxIsland</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluxKit.FluxIsland.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxKit.Core\FluxKit.Core.csproj" />
    <ProjectReference Include="..\FluxKit.Platform\FluxKit.Platform.csproj" />
  </ItemGroup>
</Project>
