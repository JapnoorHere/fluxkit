<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluxKit.App.Shell.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluxKit.App.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Padding="0,16,0,0" Spacing="{StaticResource GroupSpacing}">
            <c:PageHeader x:Name="Header" x:Uid="About_Header" IconAsset="FluxKit.png" />

            <c:SettingsGroup x:Uid="About_SystemGroup">
                <StackPanel>
                    <c:SettingRow x:Name="OsRow" x:Uid="About_Windows" Glyph="&#xE7F8;" />
                    <c:SettingRow x:Name="BackendRow" x:Uid="About_Backend" Glyph="&#xE7C4;" />
                    <c:SettingRow x:Name="SettingsRow" x:Uid="About_SettingsLocation" Glyph="&#xE8A5;" />
                    <c:SettingRow x:Name="LogsRow" x:Uid="About_LogLocation" Glyph="&#xE9D9;" />
                </StackPanel>
            </c:SettingsGroup>

            <c:SettingsGroup x:Uid="About_SupportGroup">
                <StackPanel>
                    <c:SettingRow x:Uid="About_Diagnostics" Glyph="&#xE8C8;">
                        <Button x:Name="CopyButton" Click="OnCopyDiagnostics" />
                    </c:SettingRow>
                    <c:SettingRow x:Uid="About_Docs" Glyph="&#xE736;">
                        <Button x:Uid="About_OpenDocs" Click="OnOpenDocs" />
                    </c:SettingRow>
                    <c:SettingRow x:Uid="About_Notices" Glyph="&#xE8F1;">
                        <Button x:Uid="About_OpenNotices" Click="OnOpenNotices" />
                    </c:SettingRow>
                </StackPanel>
            </c:SettingsGroup>

            <c:SettingsGroup x:Uid="About_PrivacyGroup" Glyph="&#xE72E;">
                <TextBlock x:Uid="About_PrivacyText" Margin="20,0,20,16" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </c:SettingsGroup>

            <TextBlock x:Uid="About_Copyright" HorizontalAlignment="Center" Style="{StaticResource TertiaryCaptionStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
