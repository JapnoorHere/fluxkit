<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluxKit.App.Shell.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluxKit.App.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Padding="0,16,0,0" Spacing="{StaticResource GroupSpacing}">
            <c:PageHeader x:Uid="General_Header" Glyph="&#xE713;" />

            <c:SettingsGroup x:Uid="General_StartupGroup">
                <StackPanel>
                    <c:SettingRow x:Uid="General_Startup" Glyph="&#xE7E8;">
                        <ToggleSwitch x:Name="StartupToggle" Toggled="OnStartupToggled" />
                    </c:SettingRow>
                    <InfoBar x:Name="StartupInfo" Margin="20,0,20,12" IsClosable="False" IsOpen="False">
                        <InfoBar.ActionButton>
                            <Button x:Name="StartupFixButton" x:Uid="General_StartupFix" Click="OnStartupFix" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <c:SettingRow x:Uid="General_OpenOnLaunch" Glyph="&#xE737;">
                        <ToggleSwitch x:Name="OpenOnLaunchToggle" Toggled="OnOpenOnLaunchToggled" />
                    </c:SettingRow>
                </StackPanel>
            </c:SettingsGroup>

            <c:SettingsGroup x:Uid="General_AppearanceGroup">
                <StackPanel>
                    <c:SettingRow x:Uid="General_Theme" Glyph="&#xE790;">
                        <ComboBox x:Name="ThemeCombo" SelectionChanged="OnThemeChanged" Style="{StaticResource SettingComboStyle}">
                            <ComboBoxItem x:Uid="General_ThemeSystem" />
                            <ComboBoxItem x:Uid="General_ThemeLight" />
                            <ComboBoxItem x:Uid="General_ThemeDark" />
                        </ComboBox>
                    </c:SettingRow>
                </StackPanel>
            </c:SettingsGroup>

            <c:SettingsGroup x:Uid="General_TrayGroup">
                <StackPanel>
                    <c:SettingRow x:Uid="General_TrayIcon" Glyph="&#xE9F5;">
                        <ToggleSwitch IsEnabled="False" IsOn="True" />
                    </c:SettingRow>
                </StackPanel>
            </c:SettingsGroup>

            <c:SettingsGroup x:Uid="General_DiagnosticsGroup">
                <StackPanel>
                    <c:SettingRow x:Uid="General_LogLevel" Glyph="&#xE9D9;">
                        <ComboBox x:Name="LogCombo" SelectionChanged="OnLogLevelChanged" Style="{StaticResource SettingComboStyle}">
                            <ComboBoxItem x:Uid="General_LogErrors" />
                            <ComboBoxItem x:Uid="General_LogNormal" />
                            <ComboBoxItem x:Uid="General_LogDetailed" />
                        </ComboBox>
                    </c:SettingRow>
                    <c:SettingRow x:Name="LogFolderRow" x:Uid="General_LogFiles" Glyph="&#xE8B7;">
                        <Button x:Uid="General_OpenLogFolder" Click="OnOpenLogs" />
                    </c:SettingRow>
                    <c:SettingRow x:Name="SettingsFileRow" x:Uid="General_SettingsFile" Glyph="&#xE8A5;">
                        <Button x:Uid="General_ShowSettingsFile" Click="OnOpenSettingsFile" />
                    </c:SettingRow>
                </StackPanel>
            </c:SettingsGroup>

            <c:SettingsGroup x:Uid="General_ResetGroup">
                <StackPanel>
                    <c:SettingRow x:Uid="General_ResetAll" Glyph="&#xE72C;">
                        <Button x:Uid="General_ResetButton" Click="OnReset" />
                    </c:SettingRow>
                </StackPanel>
            </c:SettingsGroup>
        </StackPanel>
    </ScrollViewer>
</Page>
