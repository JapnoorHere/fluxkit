<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluxKit.App.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluxKit.App.Controls"
    Title="FluxKit">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar across the whole window: logo, product name and a pre-release badge. -->
        <Grid x:Name="AppTitleBar" Padding="22,0,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Image Width="18" Height="18" Source="ms-appx:///Assets/FluxKit.png" />
                <TextBlock x:Uid="MainWindow_AppName" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Border
                    x:Name="PreviewBadge"
                    Padding="7,1,7,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource BrandGradientBrush}"
                    CornerRadius="8">
                    <TextBlock x:Uid="MainWindow_PreviewBadge" FontSize="11" Foreground="{ThemeResource OnBrandForegroundBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:NavRail x:Name="Rail" />
            <!-- Pages sit on a raised layer with a rounded top-left corner, like Windows 11 apps. -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Frame x:Name="ContentFrame" />
            </Border>
        </Grid>
    </Grid>
</Window>
