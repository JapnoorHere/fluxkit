<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluxKit.App.Shell.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Padding="0,16,0,0" Spacing="20">
            <!-- Greeting and an at-a-glance status chip. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="GreetingText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock x:Uid="Home_Subtitle" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ChipDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="ChipText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar x:Name="AttentionBar" IsOpen="False" />

            <ItemsRepeater x:Name="ToolTiles">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="{StaticResource ToolTileHeight}"
                        MinItemWidth="{StaticResource ToolTileWidth}"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!-- While Flux Island is on: a few of its moments to try on the real island, and the tour. -->
            <Border x:Name="IslandCard" Padding="20,16" Style="{StaticResource GroupCardStyle}" Visibility="Collapsed">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="Home_IslandTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Home_IslandText" Style="{StaticResource TertiaryCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnTourClicked"
                        Style="{StaticResource AccentButtonStyle}"
                        x:Uid="Home_IslandTour" />
                    <StackPanel
                        x:Name="IslandTries"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8" />
                </Grid>
            </Border>

            <!-- Three short facts instead of a long "how it works" card. -->
            <Border Padding="20,14" Style="{StaticResource GroupCardStyle}">
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon VerticalAlignment="Top" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE9F5;" />
                        <StackPanel MaxWidth="260" Spacing="2">
                            <TextBlock x:Uid="Home_TipTrayTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="Home_TipTrayText" Style="{StaticResource TertiaryCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <FontIcon VerticalAlignment="Top" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE74E;" />
                        <StackPanel MaxWidth="260" Spacing="2">
                            <TextBlock x:Uid="Home_TipSavedTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="Home_TipSavedText" Style="{StaticResource TertiaryCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <FontIcon VerticalAlignment="Top" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE72E;" />
                        <StackPanel MaxWidth="260" Spacing="2">
                            <TextBlock x:Uid="Home_TipPrivateTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="Home_TipPrivateText" Style="{StaticResource TertiaryCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
