<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluxKit.App.Controls.ToolPageLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Wide: the preview stays in view on the left while the settings scroll on the right.
        Narrow: the preview sits above the settings and everything scrolls together.
    -->
    <Grid x:Name="RootGrid" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="PreviewScroller" Width="{StaticResource ToolPreviewWidth}" Padding="0,0,0,24" VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="WidePreviewHost" />
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsScroller" Grid.Column="1" Padding="0,0,12,32">
            <StackPanel Spacing="{StaticResource GroupSpacing}">
                <ContentPresenter x:Name="NarrowPreviewHost" />
                <ContentPresenter Content="{x:Bind Settings, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
