<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluxKit.App.Controls.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A Windows 11 Settings-style card: icon, header, description and a trailing control. -->
    <Border
        MinHeight="68"
        Padding="16,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="IconElement"
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="{x:Bind Glyph, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DescriptionElement"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Description, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="{x:Bind Action, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
