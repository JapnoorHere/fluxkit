<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluxKit.App.Controls.ToolTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        A launchpad tile. The whole card opens the tool; the switch sits on top of the card (not inside the
        button) so it can be used without opening the tool, and screen readers see two separate controls.
    -->
    <Grid Height="{StaticResource ToolTileHeight}">
        <Button
            x:Name="OpenButton"
            Click="OnOpenClick"
            Style="{StaticResource TileButtonStyle}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource BrandSubtleGradientBrush}"
                    BorderBrush="{ThemeResource BrandStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SquircleCornerRadius}">
                    <Grid>
                        <Image x:Name="IconImage" Width="28" Height="28" />
                        <FontIcon x:Name="IconGlyph" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    MaxLines="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Description, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Button>
        <ToggleSwitch
            x:Name="Toggle"
            MinWidth="0"
            Margin="0,16,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            OffContent=""
            OnContent=""
            Toggled="OnToggled" />

        <!-- Placeholder look for the "more tools" tile. -->
        <Grid x:Name="PlaceholderRoot" Visibility="Collapsed">
            <Rectangle
                RadiusX="8"
                RadiusY="8"
                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                StrokeDashArray="4,3"
                StrokeThickness="1" />
            <StackPanel Padding="20" VerticalAlignment="Center" Spacing="6">
                <FontIcon HorizontalAlignment="Left" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE710;" />
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource TertiaryCaptionStyle}" Text="{x:Bind Description, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
