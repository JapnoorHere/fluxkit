<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluxKit.App.Modules.FluxIsland.FluxIslandPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluxKit.App.Controls"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland">
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Margin="32,24,20,0" RowSpacing="{StaticResource GroupSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader x:Name="Header" x:Uid="FluxIsland_Header" Margin="0,0,12,0" IconAsset="FluxIsland.png">
            <ToggleSwitch x:Name="EnabledToggle" x:Uid="FluxIsland_Enabled" MinWidth="0" Toggled="OnEnabledToggled" />
        </c:PageHeader>

        <!-- Only for problems; the normal status lives in the header. -->
        <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="0,0,12,0" IsClosable="False" IsOpen="False" />

        <c:ToolPageLayout Grid.Row="2">
            <c:ToolPageLayout.Preview>
                <local:IslandPreview x:Name="Preview" />
            </c:ToolPageLayout.Preview>

            <StackPanel x:Name="OptionsPanel" Spacing="{StaticResource GroupSpacing}">
                <!-- Try any moment on the real island, or replay the tour. Buttons are built from IslandSamples. -->
                <c:SettingsGroup x:Uid="FluxIsland_TryGroup">
                    <StackPanel Padding="16,12" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                x:Uid="FluxIsland_TryIntro" />
                            <Button
                                x:Name="TourButton"
                                Grid.Column="1"
                                Click="OnTourClicked"
                                Style="{StaticResource AccentButtonStyle}"
                                x:Uid="FluxIsland_ReplayTour" />
                        </Grid>
                        <VariableSizedWrapGrid
                            x:Name="Gallery"
                            ItemHeight="40"
                            ItemWidth="132"
                            Orientation="Horizontal" />
                        <VariableSizedWrapGrid
                            x:Name="MoreGallery"
                            ItemHeight="40"
                            ItemWidth="132"
                            Orientation="Horizontal"
                            Visibility="Collapsed" />
                        <HyperlinkButton x:Name="MoreButton" Padding="0" Click="OnMoreClicked" />
                    </StackPanel>
                </c:SettingsGroup>

                <c:SettingsGroup x:Uid="FluxIsland_AppearanceGroup">
                    <StackPanel>
                        <c:SettingRow x:Uid="FluxIsland_Look" Glyph="&#xE790;">
                            <ComboBox x:Name="LookCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="FluxIsland_LookOnyx" />
                                <ComboBoxItem x:Uid="FluxIsland_LookGlass" />
                                <ComboBoxItem x:Uid="FluxIsland_LookMercury" />
                                <ComboBoxItem x:Uid="FluxIsland_LookPureBlack" />
                                <ComboBoxItem x:Uid="FluxIsland_LookGraphite" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_WindowsAccent" Glyph="&#xE790;">
                            <ToggleSwitch x:Name="AccentToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_LightHalo" Glyph="&#xE781;">
                            <ToggleSwitch x:Name="HaloToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Name="EffectsRow" x:Uid="FluxIsland_Effects" Glyph="&#xE8B1;">
                            <ComboBox x:Name="EffectsCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="FluxIsland_EffectsFull" />
                                <ComboBoxItem x:Uid="FluxIsland_EffectsLight" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_Monitor" Glyph="&#xE7F4;">
                            <ComboBox x:Name="MonitorCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="FluxIsland_MonitorMain" />
                                <ComboBoxItem x:Uid="FluxIsland_MonitorMouse" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_Interruptions" Glyph="&#xE7E7;">
                            <ComboBox x:Name="InterruptionsCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="FluxIsland_InterruptEverything" />
                                <ComboBoxItem x:Uid="FluxIsland_InterruptImportant" />
                                <ComboBoxItem x:Uid="FluxIsland_InterruptNothing" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_SoundRipples" Glyph="&#xE9E9;">
                            <ToggleSwitch x:Name="RipplesToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_Sounds" Glyph="&#xE767;">
                            <ToggleSwitch x:Name="SoundsToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_HideFullScreen" Glyph="&#xE740;">
                            <ToggleSwitch x:Name="FullScreenToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>

                <c:SettingsGroup x:Uid="FluxIsland_ShowGroup">
                    <StackPanel x:Name="ShowRows">
                        <c:SettingRow x:Uid="FluxIsland_ShowMedia" Glyph="&#xE8D6;">
                            <ToggleSwitch x:Name="MediaToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowCalls" Glyph="&#xE717;">
                            <ToggleSwitch x:Name="CallsToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowPrivacy" Glyph="&#xE720;">
                            <ToggleSwitch x:Name="PrivacyToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowPower" Glyph="&#xE945;">
                            <ToggleSwitch x:Name="PowerToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowNetwork" Glyph="&#xE774;">
                            <ToggleSwitch x:Name="NetworkToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowClipboard" Glyph="&#xE8C8;">
                            <ToggleSwitch x:Name="ClipboardToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowSaver" Glyph="&#xEC0A;">
                            <ToggleSwitch x:Name="SaverToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowBrightness" Glyph="&#xE706;">
                            <ToggleSwitch x:Name="BrightnessToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_SmartCopy" Glyph="&#xE71B;">
                            <ToggleSwitch x:Name="SmartCopyToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ClipboardHistory" Glyph="&#xE77F;">
                            <ToggleSwitch x:Name="ClipboardHistoryToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowVolume" Glyph="&#xE995;">
                            <ToggleSwitch x:Name="VolumeChangesToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowAudioDevices" Glyph="&#xE7F6;">
                            <ToggleSwitch x:Name="AudioDevicesToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowMicMute" Glyph="&#xE720;">
                            <ToggleSwitch x:Name="MicMuteToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowDesktops" Glyph="&#xE7C4;">
                            <ToggleSwitch x:Name="DesktopsToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowDownloads" Glyph="&#xE896;">
                            <ToggleSwitch x:Name="DownloadsToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowScreenshots" Glyph="&#xE722;">
                            <ToggleSwitch x:Name="ScreenshotsToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowLockKeys" Glyph="&#xE765;">
                            <ToggleSwitch x:Name="LockKeysToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowDevices" Glyph="&#xE702;">
                            <ToggleSwitch x:Name="DevicesToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ShowClock" Glyph="&#xE823;">
                            <ToggleSwitch x:Name="ClockToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>

                <c:SettingsGroup x:Uid="FluxIsland_InteractGroup">
                    <StackPanel>
                        <c:SettingRow x:Uid="FluxIsland_Shelf" Glyph="&#xE7B8;">
                            <ToggleSwitch x:Name="ShelfToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_KeepShelf" Glyph="&#xE74E;">
                            <ToggleSwitch x:Name="KeepShelfToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_KeepNotes" Glyph="&#xE70B;">
                            <ToggleSwitch x:Name="KeepNotesToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_ScrollVolume" Glyph="&#xE767;">
                            <ToggleSwitch x:Name="VolumeToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_Glance" Glyph="&#xE9D9;">
                            <ToggleSwitch x:Name="GlanceToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Name="HotkeyRow" x:Uid="FluxIsland_Hotkey" Glyph="&#xE765;">
                            <TextBox
                                x:Name="HotkeyBox"
                                Width="180"
                                x:Uid="FluxIsland_HotkeyBox"
                                KeyDown="OnHotkeyKeyDown"
                                LostFocus="OnHotkeyCommitted" />
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>

                <local:NotificationSettings x:Name="NotificationsView" />

                <c:SettingsGroup x:Uid="FluxIsland_FocusGroup">
                    <StackPanel>
                        <c:SettingRow x:Uid="FluxIsland_FocusLength" Glyph="&#xE916;">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider
                                    x:Name="FocusSlider"
                                    Width="180"
                                    Maximum="90"
                                    Minimum="5"
                                    StepFrequency="5"
                                    TickFrequency="15"
                                    ValueChanged="OnLengthChanged" />
                                <TextBlock x:Name="FocusText" MinWidth="56" VerticalAlignment="Center" />
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_BreakLength" Glyph="&#xE708;">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider
                                    x:Name="BreakSlider"
                                    Width="180"
                                    Maximum="30"
                                    Minimum="1"
                                    StepFrequency="1"
                                    TickFrequency="5"
                                    ValueChanged="OnLengthChanged" />
                                <TextBlock x:Name="BreakText" MinWidth="56" VerticalAlignment="Center" />
                            </StackPanel>
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>

                <c:SettingsGroup x:Uid="FluxIsland_LabsGroup">
                    <StackPanel>
                        <c:SettingRow x:Uid="FluxIsland_LiveActivities" Glyph="&#xE756;">
                            <ToggleSwitch x:Name="LiveToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_WindowPeek" Glyph="&#xE7B3;">
                            <ToggleSwitch x:Name="PeekToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="FluxIsland_WindowStash" Glyph="&#xE7B8;">
                            <ToggleSwitch x:Name="StashToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>
            </StackPanel>
        </c:ToolPageLayout>
    </Grid>
</Page>
