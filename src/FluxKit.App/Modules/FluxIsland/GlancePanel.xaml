<?xml version="1.0" encoding="utf-8"?>
<!--
    The Glance page (plan §4.4), laid out as tiles: CPU, memory, disk and battery, each a ring with its value inside;
    a wide network tile with live speeds and a sparkline; then round quick actions. Numbers are read once a second,
    only while this page is on screen.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.GlancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid
        x:Name="ContentGrid"
        Padding="16,16,16,6"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Gauges" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CpuGauge" Height="96" Background="#1C1C1E" CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Grid Width="48" Height="48">
                        <local:ProgressGlyph x:Name="CpuRing" Width="48" Height="48" />
                        <TextBlock x:Name="CpuText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <TextBlock x:Name="CpuLabel" HorizontalAlignment="Center" Style="{StaticResource IslandCaptionText}" x:Uid="Island_GlanceCpu" />
                </StackPanel>
            </Border>
            <Border x:Name="MemoryGauge" Grid.Column="1" Height="96" Background="#1C1C1E" CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Grid Width="48" Height="48">
                        <local:ProgressGlyph x:Name="MemoryRing" Width="48" Height="48" />
                        <TextBlock x:Name="MemoryText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <TextBlock x:Name="MemoryLabel" HorizontalAlignment="Center" Style="{StaticResource IslandCaptionText}" x:Uid="Island_GlanceMemory" />
                </StackPanel>
            </Border>
            <Border x:Name="DiskGauge" Grid.Column="2" Height="96" Background="#1C1C1E" CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Grid Width="48" Height="48">
                        <local:ProgressGlyph x:Name="DiskRing" Width="48" Height="48" />
                        <TextBlock x:Name="DiskText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <TextBlock x:Name="DiskLabel" HorizontalAlignment="Center" Style="{StaticResource IslandCaptionText}" x:Uid="Island_GlanceDisk" />
                </StackPanel>
            </Border>
            <Border x:Name="BatteryGauge" Grid.Column="3" Height="96" Background="#1C1C1E" CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Grid Width="48" Height="48">
                        <local:ProgressGlyph x:Name="BatteryRing" Width="48" Height="48" />
                        <TextBlock x:Name="BatteryText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <TextBlock x:Name="BatteryLabel" HorizontalAlignment="Center" Style="{StaticResource IslandCaptionText}" x:Uid="Island_GlanceBattery" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Network: download and upload speed, with the last minute of download as a sparkline. -->
        <Border
            x:Name="NetworkTile"
            Grid.Row="1"
            Height="48"
            Padding="16,0"
            Background="#1C1C1E"
            CornerRadius="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="DownGlyph" FontSize="12" Glyph="&#xE74B;" />
                    <TextBlock x:Name="DownText" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="UpGlyph" FontSize="12" Glyph="&#xE74A;" />
                    <TextBlock x:Name="UpText" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <Grid
                    x:Name="SparkHost"
                    Grid.Column="2"
                    Height="26"
                    VerticalAlignment="Center">
                    <Polyline
                        x:Name="Spark"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.6" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel
            x:Name="Actions"
            Grid.Row="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="14">
            <Button x:Name="ScreenshotButton" Style="{StaticResource IslandGhostButtonStyle}" Background="#1C1C1E" x:Uid="Island_GlanceScreenshot">
                <FontIcon FontSize="15" Glyph="&#xE722;" />
            </Button>
            <Button x:Name="LockButton" Style="{StaticResource IslandGhostButtonStyle}" Background="#1C1C1E" x:Uid="Island_GlanceLock">
                <FontIcon FontSize="15" Glyph="&#xE72E;" />
            </Button>
            <Button x:Name="DisplayOffButton" Style="{StaticResource IslandGhostButtonStyle}" Background="#1C1C1E" x:Uid="Island_GlanceDisplayOff">
                <FontIcon FontSize="15" Glyph="&#xE708;" />
            </Button>
            <Button x:Name="MicButton" Style="{StaticResource IslandGhostButtonStyle}" Background="#1C1C1E">
                <FontIcon x:Name="MicGlyph" FontSize="15" />
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource IslandGhostButtonStyle}" Background="#1C1C1E" x:Uid="Island_GlanceSettings">
                <FontIcon FontSize="15" Glyph="&#xE713;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
