<?xml version="1.0" encoding="utf-8"?>
<!--
    The island: a compositor-drawn pill (PillShape) with XAML content on top, clipped to the same shape.
    The stage is larger than the biggest pill so the spring overshoot and the shadow are never cut off.
    Text colours are set in code from IslandPalette, because the pill is dark whatever the app theme.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.IslandPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="Stage">
        <Grid x:Name="ShapeHost" IsHitTestVisible="False" />
        <Grid x:Name="ContentLayer">
            <Grid
                x:Name="Surface"
                TabFocusNavigation="Cycle"
                XYFocusKeyboardNavigation="Enabled"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent">
                <Grid x:Name="IdleView">
                    <TextBlock
                        x:Name="IdleClock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold" />
                    <local:PrivacyDots
                        x:Name="IdleDots"
                        Margin="0,0,14,0"
                        HorizontalAlignment="Right" />
                </Grid>

                <Grid
                    x:Name="CompactView"
                    Padding="14,0"
                    ColumnSpacing="10"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Ellipse
                            x:Name="CompactBurst"
                            Width="22"
                            Height="22"
                            StrokeThickness="2"
                            Opacity="0" />
                        <FontIcon x:Name="CompactGlyph" FontSize="16" />
                        <local:ProgressGlyph x:Name="CompactRing" Visibility="Collapsed" />
                        <Border
                            x:Name="CompactArtFrame"
                            Width="22"
                            Height="22"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <Image x:Name="CompactArt" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CompactTitle"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CompactSubtitle"
                            FontSize="12"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                        <!-- The volume level, in place of the title while the wheel changes it. -->
                        <Grid
                            x:Name="CompactLevel"
                            Width="132"
                            Height="6"
                            Visibility="Collapsed">
                            <Border Background="#33FFFFFF" CornerRadius="3" />
                            <Border x:Name="CompactLevelFill" CornerRadius="3" />
                        </Grid>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="CompactTrail"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold" />
                        <local:PlayingBars x:Name="CompactBars" Visibility="Collapsed" />
                        <!-- The one thing to do about this moment (Unmute, Open…), offered while peeking. -->
                        <Button
                            x:Name="CompactAction"
                            VerticalAlignment="Center"
                            Style="{StaticResource IslandChipButtonStyle}"
                            Visibility="Collapsed" />
                        <local:PrivacyDots x:Name="CompactDots" />
                    </StackPanel>
                </Grid>

                <local:MediaPanel x:Name="MediaView" Visibility="Collapsed" />
                <local:TimerPanel x:Name="TimerView" Visibility="Collapsed" />
                <local:ShelfPanel x:Name="ShelfView" Visibility="Collapsed" />
                <local:GlancePanel x:Name="GlanceView" Visibility="Collapsed" />

                <!-- Switches between the panel's pages when there is more than one, like FluxKit's own side rail. -->
                <StackPanel
                    x:Name="PanelRail"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="4"
                    Visibility="Collapsed">
                    <Button
                        x:Name="MediaTab"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Style="{StaticResource IslandIconButtonStyle}"
                        x:Uid="Island_MediaTab">
                        <FontIcon FontSize="13" Glyph="&#xE8D6;" />
                    </Button>
                    <Button
                        x:Name="TimerTab"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Style="{StaticResource IslandIconButtonStyle}"
                        x:Uid="Island_TimerTab">
                        <FontIcon FontSize="13" Glyph="&#xE916;" />
                    </Button>
                    <Button
                        x:Name="ShelfTab"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Style="{StaticResource IslandIconButtonStyle}"
                        x:Uid="Island_ShelfTab">
                        <FontIcon FontSize="13" Glyph="&#xE7B8;" />
                    </Button>
                    <Button
                        x:Name="GlanceTab"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Style="{StaticResource IslandIconButtonStyle}"
                        x:Uid="Island_GlanceTab">
                        <FontIcon FontSize="13" Glyph="&#xE9D9;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The second activity, in a small bubble beside the pill (like a second Live Activity). Click to swap. -->
        <Grid
            x:Name="Bubble"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="Transparent"
            Visibility="Collapsed">
            <Ellipse x:Name="BubbleFill" />
            <Ellipse x:Name="BubbleEdge" StrokeThickness="1" />
            <FontIcon x:Name="BubbleGlyph" FontSize="15" />
            <Ellipse
                x:Name="BubbleArt"
                Width="26"
                Height="26"
                Visibility="Collapsed">
                <Ellipse.Fill>
                    <ImageBrush x:Name="BubbleArtBrush" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Grid>
</UserControl>
