<?xml version="1.0" encoding="utf-8"?>
<!--
    The island: a compositor-drawn pill (PillShape) with XAML content on top, clipped to the same shape.
    The stage is larger than the biggest pill so the spring overshoot and the shadow are never cut off.
    Text colours are set in code from IslandPalette, because the pill is dark whatever the app theme.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.IslandPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <Grid x:Name="Stage">
        <Grid x:Name="ShapeHost" IsHitTestVisible="False" />
        <Grid x:Name="ContentLayer">
            <Grid
                x:Name="Surface"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent">
                <Grid x:Name="IdleView">
                    <TextBlock
                        x:Name="IdleClock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold" />
                    <local:PrivacyDots
                        x:Name="IdleDots"
                        Margin="0,0,14,0"
                        HorizontalAlignment="Right" />
                </Grid>

                <Grid
                    x:Name="CompactView"
                    Padding="14,0"
                    ColumnSpacing="10"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <FontIcon x:Name="CompactGlyph" FontSize="16" />
                        <local:ChargeRing x:Name="CompactRing" Visibility="Collapsed" />
                        <Border
                            x:Name="CompactArtFrame"
                            Width="22"
                            Height="22"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <Image x:Name="CompactArt" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CompactTitle"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CompactSubtitle"
                            FontSize="12"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="CompactTrail"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold" />
                        <local:PlayingBars x:Name="CompactBars" Visibility="Collapsed" />
                        <local:PrivacyDots x:Name="CompactDots" />
                    </StackPanel>
                </Grid>

                <local:MediaPanel x:Name="MediaView" Visibility="Collapsed" />

                <Grid
                    x:Name="PanelView"
                    Padding="22,16,22,18"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="PanelHeader" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PanelClock" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="PanelDate" FontSize="13" />
                        </StackPanel>
                        <StackPanel
                            x:Name="PanelBattery"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                            <FontIcon x:Name="PanelBatteryGlyph" FontSize="16" />
                            <TextBlock x:Name="PanelBatteryText" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="PanelHint"
                        Grid.Row="1"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        TextWrapping="Wrap"
                        x:Uid="Island_PanelHint" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
