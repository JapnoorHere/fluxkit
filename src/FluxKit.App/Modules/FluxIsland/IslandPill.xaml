<?xml version="1.0" encoding="utf-8"?>
<!--
    The island: a compositor-drawn pill (PillShape) with XAML content on top, clipped to the same shape.
    The stage is larger than the biggest pill so the spring overshoot and the shadow are never cut off.
    Text colours are set in code from IslandPalette, because the pill is dark whatever the app theme.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.IslandPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    xmlns:d="using:FluxKit.App.Modules.FluxIsland.Design"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="Stage">
        <Grid x:Name="ShapeHost" IsHitTestVisible="False" />
        <Grid x:Name="ContentLayer">
            <Grid
                x:Name="Surface"
                TabFocusNavigation="Cycle"
                XYFocusKeyboardNavigation="Enabled"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent">
                <Grid x:Name="IdleView">
                    <TextBlock
                        x:Name="IdleClock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold" />
                    <local:PrivacyDots
                        x:Name="IdleDots"
                        Margin="0,0,14,0"
                        HorizontalAlignment="Right" />
                </Grid>

                <Grid
                    x:Name="CompactView"
                    Padding="14,0"
                    ColumnSpacing="10"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Ellipse
                            x:Name="CompactBurst"
                            Width="22"
                            Height="22"
                            StrokeThickness="2"
                            Opacity="0" />
                        <d:IconBadge x:Name="CompactGlyph" BadgeSize="24" />
                        <local:ProgressGlyph x:Name="CompactRing" Visibility="Collapsed" />
                        <Border
                            x:Name="CompactArtFrame"
                            Width="22"
                            Height="22"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <Image x:Name="CompactArt" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CompactTitle"
                            MaxLines="1"
                            Style="{StaticResource IslandCompactText}"
                            FontSize="14"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CompactSubtitle"
                            FontSize="12"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                        <!-- The volume level, in place of the title while the wheel changes it. -->
                        <Grid
                            x:Name="CompactLevel"
                            Width="132"
                            Height="6"
                            Visibility="Collapsed">
                            <Border Background="#33FFFFFF" CornerRadius="3" />
                            <Border x:Name="CompactLevelFill" CornerRadius="3" />
                        </Grid>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="CompactTrail"
                            VerticalAlignment="Center"
                            Style="{StaticResource IslandCompactText}" />
                        <local:PlayingBars x:Name="CompactBars" Visibility="Collapsed" />
                        <!-- The one thing to do about this moment (Unmute, Open…), offered while peeking. -->
                        <Button
                            x:Name="CompactAction"
                            Height="30"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IslandChipButtonStyle}"
                            Visibility="Collapsed" />
                        <local:PrivacyDots x:Name="CompactDots" />
                    </StackPanel>
                </Grid>

                <local:MediaPanel x:Name="MediaView" Visibility="Collapsed" />
                <local:TimerPanel x:Name="TimerView" Visibility="Collapsed" />
                <local:ShelfPanel x:Name="ShelfView" Visibility="Collapsed" />
                <local:GlancePanel x:Name="GlanceView" Visibility="Collapsed" />
                <local:ListPanel x:Name="NotesView" Visibility="Collapsed" />
                <local:ListPanel x:Name="RewindView" Visibility="Collapsed" />
                <local:ListPanel x:Name="ClipsView" Visibility="Collapsed" />
                <local:ListPanel x:Name="InboxView" Visibility="Collapsed" />
                <local:PeekPanel x:Name="PeekView" Visibility="Collapsed" />
                <local:ListPanel x:Name="StashView" Visibility="Collapsed" />
                <local:CommandBar x:Name="CommandView" Visibility="Collapsed" />
                <local:DropZones x:Name="DropView" Visibility="Collapsed" />

                <!-- Page dots under the open panel, as on a phone's home screen. Click one, or swipe sideways. -->
                <StackPanel
                    x:Name="PanelRail"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <Button x:Name="MediaTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_MediaTab">
                        <Border x:Name="MediaDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="TimerTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_TimerTab">
                        <Border x:Name="TimerDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="ShelfTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_ShelfTab">
                        <Border x:Name="ShelfDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="GlanceTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_GlanceTab">
                        <Border x:Name="GlanceDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="NotesTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_NotesTab">
                        <Border x:Name="NotesDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="RewindTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_RewindTab">
                        <Border x:Name="RewindDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="ClipsTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_ClipsTab">
                        <Border x:Name="ClipsDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="InboxTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_InboxTab">
                        <Border x:Name="InboxDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="PeekTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_PeekTab">
                        <Border x:Name="PeekDot" Height="6" CornerRadius="3" />
                    </Button>
                    <Button x:Name="StashTab" Style="{StaticResource IslandDotStyle}" x:Uid="Island_StashTab">
                        <Border x:Name="StashDot" Height="6" CornerRadius="3" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- A short tip under the pill: the first-run tour, or a gesture shown once ("Click the bubble to swap"). -->
        <Border
            x:Name="Hint"
            Padding="6,6,14,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#F21C1C1E"
            BorderBrush="#2EFFFFFF"
            BorderThickness="0,1,0,0"
            CornerRadius="16"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <d:IconBadge x:Name="HintBadge" BadgeSize="20" />
                <TextBlock
                    x:Name="HintText"
                    MaxWidth="330"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="#FFFFFF" />
                <TextBlock
                    x:Name="HintSteps"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Foreground="#80EBEBF5"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- The second activity, in a small bubble beside the pill (like a second Live Activity). Click to swap. -->
        <Grid
            x:Name="Bubble"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="Transparent"
            Visibility="Collapsed">
            <Ellipse x:Name="BubbleFill" />
            <Ellipse x:Name="BubbleEdge" StrokeThickness="1" />
            <d:IconBadge
                x:Name="BubbleGlyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BadgeSize="28" />
            <Ellipse
                x:Name="BubbleArt"
                Width="26"
                Height="26"
                Visibility="Collapsed">
                <Ellipse.Fill>
                    <ImageBrush x:Name="BubbleArtBrush" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Grid>
</UserControl>
