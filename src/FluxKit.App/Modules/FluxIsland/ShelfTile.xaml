<?xml version="1.0" encoding="utf-8"?>
<!-- One file on the shelf: its icon and name. Drag it out to drop the file anywhere; hover to show the remove button. -->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.ShelfTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="72"
    Height="70"
    CanDrag="True"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid>
        <Border
            x:Name="Card"
            Background="#14FFFFFF"
            CornerRadius="14" />
        <StackPanel
            Padding="6,8,6,6"
            VerticalAlignment="Center"
            Spacing="6">
            <Grid Width="30" Height="30">
                <FontIcon
                    x:Name="Fallback"
                    FontSize="22"
                    Glyph="&#xE8A5;" />
                <Image x:Name="Icon" Stretch="Uniform" />
            </Grid>
            <TextBlock
                x:Name="FileName"
                HorizontalAlignment="Center"
                FontSize="11"
                MaxLines="1"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button
            x:Name="RemoveButton"
            Width="20"
            Height="20"
            Margin="0,3,3,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#40FFFFFF"
            CornerRadius="10"
            Style="{StaticResource IslandIconButtonStyle}"
            Visibility="Collapsed"
            x:Uid="Island_RemoveFromShelf">
            <FontIcon FontSize="8" Glyph="&#xE711;" />
        </Button>
    </Grid>
</UserControl>
