<?xml version="1.0" encoding="utf-8"?>
<!-- Three music bars. They follow the real output level (PlayingBars.SetLevel) and fall back to a bounce. -->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.PlayingBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <StackPanel
        Height="14"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="2">
        <Rectangle
            x:Name="Bar1"
            Width="3"
            Height="14"
            RadiusX="1.5"
            RadiusY="1.5" />
        <Rectangle
            x:Name="Bar2"
            Width="3"
            Height="14"
            RadiusX="1.5"
            RadiusY="1.5" />
        <Rectangle
            x:Name="Bar3"
            Width="3"
            Height="14"
            RadiusX="1.5"
            RadiusY="1.5" />
    </StackPanel>
</UserControl>
