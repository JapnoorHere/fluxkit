<?xml version="1.0" encoding="utf-8"?>
<!--
    The island's timer page. With no timer: the clock, the date, the battery and quick timers.
    With a timer: rolling digits, a progress bar, and pause and cancel.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.TimerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="ContentGrid" Padding="20,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="IdleHeader" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Clock" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="Date" FontSize="13" />
            </StackPanel>
            <StackPanel
                x:Name="Battery"
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon x:Name="BatteryGlyph" FontSize="16" />
                <TextBlock x:Name="BatteryText" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ActiveHeader" Spacing="2" Visibility="Collapsed">
            <TextBlock x:Name="Label" FontSize="13" />
            <local:RollingText x:Name="Digits" />
            <Grid
                Height="4"
                Margin="0,8,0,0"
                SizeChanged="OnTrackSizeChanged">
                <Border Background="#33FFFFFF" CornerRadius="2" />
                <Border
                    x:Name="ProgressFill"
                    Width="0"
                    HorizontalAlignment="Left"
                    CornerRadius="2" />
            </Grid>
        </StackPanel>

        <StackPanel
            x:Name="QuickRow"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Spacing="8">
            <TextBlock x:Name="QuickLabel" FontSize="12" x:Uid="Island_QuickTimerLabel" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="OneMinute"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_OneMinute" />
                <Button
                    x:Name="FiveMinutes"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_FiveMinutes" />
                <Button
                    x:Name="TenMinutes"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_TenMinutes" />
                <Button x:Name="FocusButton" Style="{StaticResource IslandChipButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE916;" />
                        <TextBlock x:Name="FocusText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel
            x:Name="ActiveRow"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <Button x:Name="PauseButton" Style="{StaticResource IslandChipButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="PauseGlyph" FontSize="12" />
                    <TextBlock x:Name="PauseText" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource IslandChipButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                    <TextBlock x:Uid="Island_CancelTimer" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
