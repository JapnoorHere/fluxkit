<?xml version="1.0" encoding="utf-8"?>
<!--
    The island's timer page. With no timer: the clock, the date, the battery and quick timers.
    With a timer: rolling digits, a progress bar, and pause and cancel.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.TimerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="ContentGrid" Padding="20,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="IdleHeader" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Clock" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="Date" FontSize="13" />
            </StackPanel>
            <StackPanel
                x:Name="Battery"
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon x:Name="BatteryGlyph" FontSize="16" />
                <TextBlock x:Name="BatteryText" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- A running timer or stopwatch: a dial that empties (or a seconds hand that sweeps) beside big digits. -->
        <Grid x:Name="ActiveHeader" ColumnSpacing="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:ProgressGlyph
                x:Name="Dial"
                Width="64"
                Height="64"
                VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock x:Name="Label" Style="{StaticResource IslandCaptionText}" />
                <local:RollingText x:Name="Digits" />
                <!-- The stopwatch's latest laps, newest first. -->
                <TextBlock
                    x:Name="LapsText"
                    Margin="0,2,0,0"
                    FontSize="12"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="QuickRow"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Spacing="8">
            <TextBlock x:Name="QuickLabel" Style="{StaticResource IslandCaptionText}" x:Uid="Island_QuickTimerLabel" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="OneMinute"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_OneMinute" />
                <Button
                    x:Name="FiveMinutes"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_FiveMinutes" />
                <Button
                    x:Name="TenMinutes"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_TenMinutes" />
                <Button x:Name="FocusButton" Style="{StaticResource IslandChipButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE916;" />
                        <TextBlock x:Name="FocusText" />
                    </StackPanel>
                </Button>
                <!-- Counts up instead of down; icon only so the row still fits. -->
                <Button
                    x:Name="StopwatchButton"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_StartStopwatch">
                    <FontIcon FontSize="12" Glyph="&#xE121;" />
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel
            x:Name="ActiveRow"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <!-- Shown while a timer and the stopwatch both run: flips the page between them. -->
            <Button
                x:Name="SwitchButton"
                Style="{StaticResource IslandChipButtonStyle}"
                Visibility="Collapsed">
                <FontIcon x:Name="SwitchGlyph" FontSize="12" />
            </Button>
            <Button x:Name="PauseButton" Style="{StaticResource IslandChipButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="PauseGlyph" FontSize="12" />
                    <TextBlock x:Name="PauseText" />
                </StackPanel>
            </Button>
            <!-- "+1 min" for a timer, "Lap" for the stopwatch. -->
            <Button x:Name="ExtraButton" Style="{StaticResource IslandChipButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="ExtraGlyph" FontSize="12" />
                    <TextBlock x:Name="ExtraText" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource IslandChipButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                    <TextBlock x:Name="CancelText" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
