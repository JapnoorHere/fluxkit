<?xml version="1.0" encoding="utf-8"?>
<!--
    The timers page (plan §4.4).
    Idle: the clock and date, then a row of tiles to start a timer, a focus round or the stopwatch.
    Running (like the iOS timer): a dial that empties beside big orange digits, then round buttons to pause and stop.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.TimerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid
        x:Name="ContentGrid"
        Padding="20,18,20,6"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="IdleHeader" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="0">
                <TextBlock x:Name="Clock" Style="{StaticResource IslandDisplayText}" />
                <TextBlock x:Name="Date" Style="{StaticResource IslandBodyText}" />
            </StackPanel>
            <StackPanel
                x:Name="Battery"
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon x:Name="BatteryGlyph" FontSize="16" />
                <TextBlock
                    x:Name="BatteryText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Grid>

        <!-- A running timer or stopwatch: the dial, then the label over big digits. -->
        <Grid
            x:Name="ActiveHeader"
            ColumnSpacing="16"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:ProgressGlyph
                x:Name="Dial"
                Width="60"
                Height="60"
                VerticalAlignment="Center" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="0">
                <TextBlock x:Name="Label" Style="{StaticResource IslandCaptionText}" />
                <local:RollingText
                    x:Name="Digits"
                    TextSize="44"
                    Bold="True" />
                <!-- The stopwatch's latest laps, newest first. -->
                <TextBlock
                    x:Name="LapsText"
                    Margin="0,2,0,0"
                    FontSize="12"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    Typography.NumeralAlignment="Tabular"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="QuickRow"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Spacing="8">
            <TextBlock
                x:Name="QuickLabel"
                Style="{StaticResource IslandCaptionText}"
                x:Uid="Island_QuickTimerLabel" />
            <Grid x:Name="Tiles" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="OneMinute"
                    Height="58"
                    Style="{StaticResource IslandTileButtonStyle}"
                    x:Uid="Island_OneMinuteTile" />
                <Button
                    x:Name="FiveMinutes"
                    Grid.Column="1"
                    Height="58"
                    Style="{StaticResource IslandTileButtonStyle}"
                    x:Uid="Island_FiveMinutesTile" />
                <Button
                    x:Name="TenMinutes"
                    Grid.Column="2"
                    Height="58"
                    Style="{StaticResource IslandTileButtonStyle}"
                    x:Uid="Island_TenMinutesTile" />
                <Button
                    x:Name="FocusButton"
                    Grid.Column="3"
                    Height="58"
                    Style="{StaticResource IslandTileButtonStyle}">
                    <TextBlock x:Name="FocusText" Visibility="Collapsed" />
                </Button>
                <Button
                    x:Name="StopwatchButton"
                    Grid.Column="4"
                    Height="58"
                    Style="{StaticResource IslandTileButtonStyle}"
                    x:Uid="Island_StartStopwatch" />
            </Grid>
        </StackPanel>

        <!-- Round controls, like the iOS timer: pause in the timer's colour, stop in grey. -->
        <StackPanel
            x:Name="ActiveRow"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="Collapsed">
            <Button x:Name="PauseButton" Style="{StaticResource IslandTintButtonStyle}">
                <Grid>
                    <FontIcon x:Name="PauseGlyph" FontSize="16" />
                    <TextBlock x:Name="PauseText" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource IslandTintButtonStyle}">
                <Grid>
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                    <TextBlock x:Name="CancelText" Visibility="Collapsed" />
                </Grid>
            </Button>
            <!-- "+1 min" for a timer, "Lap" for the stopwatch. -->
            <Button
                x:Name="ExtraButton"
                Height="44"
                Padding="16,0"
                CornerRadius="22"
                Style="{StaticResource IslandChipButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="ExtraGlyph" FontSize="13" />
                    <TextBlock x:Name="ExtraText" />
                </StackPanel>
            </Button>
            <!-- Shown while a timer and the stopwatch both run: flips the page between them. -->
            <Button
                x:Name="SwitchButton"
                Style="{StaticResource IslandGhostButtonStyle}"
                Visibility="Collapsed">
                <FontIcon x:Name="SwitchGlyph" FontSize="15" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
