<?xml version="1.0" encoding="utf-8"?>
<!--
    The island's styles (see Docs/FluxIsland-UI-PLAN.md §3). The island is always dark. Type uses Segoe UI Variable
    (Display for big numbers, Text for reading) with tabular numbers so values never shift as they change. Buttons:
    tinted circles for a moment's main action, ghost circles for secondary ones, and pill chips for choices.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="IslandDisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="IslandTextFont">Segoe UI Variable Text</FontFamily>

    <!-- Every button on the island: no borders; a gentle lift on hover, a dip when pressed. -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2C2C2E" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#232325" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#141416" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

    <!-- Type ramp. -->
    <Style x:Key="IslandHeroText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandDisplayFont}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="IslandDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandDisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="IslandTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="IslandCompactText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandDisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="IslandBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="IslandCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="#99EBEBF5" />
    </Style>

    <!-- Round, borderless icon button; transparent at rest, a soft fill on hover. Kept for older pages. -->
    <Style
        x:Key="IslandIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- A secondary action: a round, see-through button (skip, close, more). -->
    <Style
        x:Key="IslandGhostButtonStyle"
        BasedOn="{StaticResource IslandIconButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Foreground" Value="#E6FFFFFF" />
    </Style>

    <!-- A moment's main action: a round button in its colour's tint (set Background and Foreground in code). -->
    <Style
        x:Key="IslandTintButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="#381C1C1E" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- A choice, such as a timer length: a soft rounded chip. -->
    <Style
        x:Key="IslandChipButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="#1C1C1E" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- The one bright button on a page (play): white with a black glyph. -->
    <Style
        x:Key="IslandPrimaryButtonStyle"
        BasedOn="{StaticResource IslandChipButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#000000" />
    </Style>

    <!-- A raised tile (bento): quick timers, Glance values, drop zones. -->
    <Style
        x:Key="IslandTileButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="#1C1C1E" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- A page dot under the open panel: a small target around the dot it holds, with the standard focus ring. -->
    <Style x:Key="IslandDotStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        Padding="1"
                        Background="Transparent"
                        CornerRadius="14">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A keyboard key, such as "esc" or "↵", shown as a hint. -->
    <Style x:Key="IslandKeyCapStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Background" Value="#2C2C2E" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
