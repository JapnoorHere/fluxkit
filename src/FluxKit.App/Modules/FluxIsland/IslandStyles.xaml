<?xml version="1.0" encoding="utf-8"?>
<!--
    Styles shared by the island's panels. The island is always dark, so these assume the Dark theme. Values follow
    Design/IslandTokens.cs (4 px grid, chip height 32, radius 16) and IslandPalette.cs (chip fills). The theme
    resources below restyle every button on the island at once: a soft white chip that brightens on hover and dims
    when pressed, with no border.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#F5F5F7" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D9F5F5F7" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#59F5F5F7" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

    <!-- Round, borderless icon button; transparent at rest, a soft fill on hover. -->
    <Style
        x:Key="IslandIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- A soft pill-shaped chip, e.g. the quick timer lengths. -->
    <Style
        x:Key="IslandChipButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="#1CFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- The one main action on a page (play, start): a bright chip that stands out from the others. -->
    <Style
        x:Key="IslandPrimaryButtonStyle"
        BasedOn="{StaticResource IslandChipButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="#F5F5F7" />
        <Setter Property="Foreground" Value="#000000" />
    </Style>

    <!-- Text styles from the type ramp. Numbers use tabular figures so they don't shift as they change. -->
    <Style x:Key="IslandCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#A1A1AA" />
    </Style>
    <Style x:Key="IslandBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="IslandTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="IslandDisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>
</ResourceDictionary>
