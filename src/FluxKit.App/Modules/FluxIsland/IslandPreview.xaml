<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.IslandPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland">
    <StackPanel Spacing="{StaticResource GroupSpacing}">
        <!-- A live island on a small copy of the screen. It reacts to hover and clicks, but its buttons do nothing. -->
        <Border Padding="16" Style="{StaticResource GroupCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock x:Uid="Preview_Title" Style="{StaticResource GroupHeaderStyle}" />
                <Grid
                    x:Name="Screen"
                    Height="176"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Image x:Name="ScreenWallpaper" Stretch="UniformToFill" />
                    <Viewbox
                        x:Name="Scaler"
                        VerticalAlignment="Top"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <local:IslandPill x:Name="Pill" />
                    </Viewbox>
                </Grid>
                <SelectorBar x:Name="Samples" SelectionChanged="OnSampleChanged">
                    <SelectorBarItem x:Uid="IslandPreview_Music" Tag="music" />
                    <SelectorBarItem x:Uid="IslandPreview_Timer" Tag="timer" />
                    <SelectorBarItem x:Uid="IslandPreview_Shelf" Tag="shelf" />
                    <SelectorBarItem x:Uid="IslandPreview_Charging" Tag="charging" />
                    <SelectorBarItem x:Uid="IslandPreview_Clock" Tag="clock" />
                </SelectorBar>
                <TextBlock x:Uid="IslandPreview_Caption" Style="{StaticResource TertiaryCaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- The island's gestures, which nothing on screen hints at. Rows are built in code. -->
        <Border Padding="16" Style="{StaticResource GroupCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock x:Uid="IslandPreview_GesturesTitle" Style="{StaticResource GroupHeaderStyle}" />
                <StackPanel x:Name="Gestures" Spacing="10" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
