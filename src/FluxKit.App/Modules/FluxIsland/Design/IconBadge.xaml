<?xml version="1.0" encoding="utf-8"?>
<!--
    A glyph in a tinted circle: how every moment shows its icon (like iOS app symbols in coloured circles).
    The slash (for "muted") and the reveal mask (for a check that draws itself) are animated in code.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.Design.IconBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid x:Name="Root">
        <Ellipse x:Name="Disc" />
        <FontIcon x:Name="Icon" />
        <Rectangle
            x:Name="Slash"
            Height="2"
            RadiusX="1"
            RadiusY="1"
            RenderTransformOrigin="0.5,0.5"
            Visibility="Collapsed">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="-45" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
