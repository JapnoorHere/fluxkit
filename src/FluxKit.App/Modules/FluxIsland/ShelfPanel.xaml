<?xml version="1.0" encoding="utf-8"?>
<!--
    The island's shelf: files dropped on the island wait here until they are dragged out somewhere else.
    While a file is dragged over the island, a glowing drop zone shows where it will land.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.ShelfPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="using:FluxKit.App.Modules.FluxIsland.Design"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid
        x:Name="ContentGrid"
        Padding="18,12,18,14"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Height="26">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <d:IconBadge
                    x:Name="HeaderGlyph"
                    BadgeSize="28" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    Style="{StaticResource IslandTitleText}"
                    x:Uid="Island_ShelfTitle" />
                <TextBlock
                    x:Name="Count"
                    VerticalAlignment="Center"
                    FontSize="12" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="6">
                <!-- Shares every file on the shelf through the Windows share sheet (Nearby Share, mail, apps). -->
                <Button
                    x:Name="ShareButton"
                    Height="26"
                    Padding="12,0"
                    CornerRadius="13"
                    FontSize="12"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_ShareShelf" />
                <Button
                    x:Name="ClearButton"
                    Height="26"
                    Padding="12,0"
                    CornerRadius="13"
                    FontSize="12"
                    Style="{StaticResource IslandChipButtonStyle}"
                    x:Uid="Island_ClearShelf" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ItemsHost" Grid.Row="1">
            <ScrollViewer
                x:Name="Scroller"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel
                    x:Name="Items"
                    Orientation="Horizontal"
                    Spacing="8" />
            </ScrollViewer>

            <Grid
                x:Name="DropZone"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Rectangle
                    x:Name="DropOutline"
                    RadiusX="14"
                    RadiusY="14"
                    StrokeDashArray="4,3"
                    StrokeThickness="1.5" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        x:Name="DropGlyph"
                        FontSize="16"
                        Glyph="&#xE896;" />
                    <TextBlock
                        x:Name="DropText"
                        VerticalAlignment="Center"
                        FontSize="13" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
