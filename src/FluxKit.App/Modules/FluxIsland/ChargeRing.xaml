<?xml version="1.0" encoding="utf-8"?>
<!-- A bolt inside a ring that sweeps round to the battery level when the charger is plugged in. -->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.ChargeRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="22"
    Height="22"
    IsHitTestVisible="False">
    <Grid>
        <Grid x:Name="RingHost" />
        <FontIcon
            x:Name="Bolt"
            FontSize="11"
            Glyph="&#xE945;" />
    </Grid>
</UserControl>
