<?xml version="1.0" encoding="utf-8"?>
<!-- The mic (orange) and camera (green) dots, shown for as long as an app uses them. -->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.PrivacyDots"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Visibility="Collapsed">
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="4">
        <Ellipse
            x:Name="MicrophoneDot"
            Width="6"
            Height="6"
            Visibility="Collapsed" />
        <Ellipse
            x:Name="CameraDot"
            Width="6"
            Height="6"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
