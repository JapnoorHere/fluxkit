<?xml version="1.0" encoding="utf-8"?>
<!-- The open island when music is playing: art, title, a seek bar and the controls, over a glow in the album's colour. -->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.MediaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid>
        <Rectangle x:Name="Glow" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush
                    Center="0.12,0.1"
                    GradientOrigin="0.12,0.1"
                    RadiusX="0.8"
                    RadiusY="1.3">
                    <GradientStop x:Name="GlowStart" Offset="0" Color="#558A84FF" />
                    <GradientStop Offset="1" Color="#008A84FF" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid
            x:Name="ContentGrid"
            Padding="18,16,18,12"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TrackRow" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="#1FFFFFFF"
                    CornerRadius="12">
                    <Grid>
                        <FontIcon
                            x:Name="ArtFallback"
                            FontSize="22"
                            Glyph="&#xE8D6;" />
                        <Image x:Name="Art" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="Title"
                        FontSize="15"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="Artist"
                        FontSize="13"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <local:PlayingBars
                    x:Name="Bars"
                    Grid.Column="2"
                    Margin="0,4,0,0"
                    VerticalAlignment="Top" />
            </Grid>

            <Grid
                x:Name="SeekRow"
                Grid.Row="1"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="Elapsed"
                    MinWidth="32"
                    VerticalAlignment="Center"
                    FontSize="11" />
                <Grid
                    x:Name="Track"
                    Grid.Column="1"
                    Height="16"
                    Background="Transparent">
                    <Border
                        Height="4"
                        VerticalAlignment="Center"
                        Background="#33FFFFFF"
                        CornerRadius="2" />
                    <Border
                        x:Name="TrackFill"
                        Width="0"
                        Height="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="2" />
                </Grid>
                <TextBlock
                    x:Name="Remaining"
                    Grid.Column="2"
                    MinWidth="32"
                    VerticalAlignment="Center"
                    FontSize="11"
                    TextAlignment="Right" />
            </Grid>

            <StackPanel
                x:Name="ControlsRow"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">
                <Button
                    x:Name="PreviousButton"
                    Style="{StaticResource IslandIconButtonStyle}"
                    x:Uid="Island_PreviousButton">
                    <FontIcon FontSize="16" Glyph="&#xE892;" />
                </Button>
                <Button
                    x:Name="PlayPauseButton"
                    Width="44"
                    Height="44"
                    CornerRadius="22"
                    Background="#26FFFFFF"
                    Style="{StaticResource IslandIconButtonStyle}">
                    <FontIcon x:Name="PlayPauseGlyph" FontSize="18" Glyph="&#xE769;" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Style="{StaticResource IslandIconButtonStyle}"
                    x:Uid="Island_NextButton">
                    <FontIcon FontSize="16" Glyph="&#xE893;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Nothing playing: say so, and how to get something here. -->
        <StackPanel
            x:Name="EmptyState"
            Padding="18,0"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="Collapsed">
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                Background="#1FFFFFFF"
                CornerRadius="12">
                <FontIcon x:Name="EmptyGlyph" FontSize="20" Glyph="&#xE8D6;" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                x:Uid="Island_NothingPlaying" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                FontSize="12"
                TextAlignment="Center"
                TextWrapping="Wrap"
                x:Uid="Island_NothingPlayingHint" />
        </StackPanel>
    </Grid>
</UserControl>
