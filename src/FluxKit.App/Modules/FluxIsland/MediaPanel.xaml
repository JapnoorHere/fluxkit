<?xml version="1.0" encoding="utf-8"?>
<!--
    The music page (plan §4.4): the album's own colours washed across the panel, large art beside "Now playing", the
    title and artist, a scrubber that invites a drag, and the controls with a bright play button in the middle.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.MediaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="using:FluxKit.App.Modules.FluxIsland.Design"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid>
        <!--
            The colour wash: the art at 6 px, stretched (a free blur), then darkened toward the bottom so text and controls
            stay readable. Without art, a glow in the accent colour takes its place. The negative top margin (the icon bar's
            room, IslandPill.IconBarRoom) lets it run up behind the icon bar, so the whole island takes the music's colour.
        -->
        <Grid Margin="0,-40,0,0" IsHitTestVisible="False">
            <Rectangle x:Name="Glow">
                <Rectangle.Fill>
                    <RadialGradientBrush
                        Center="0.1,0.05"
                        GradientOrigin="0.1,0.05"
                        RadiusX="0.85"
                        RadiusY="1.5">
                        <GradientStop x:Name="GlowStart" Offset="0" Color="#66FF375F" />
                        <GradientStop Offset="1" Color="#00FF375F" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image
                x:Name="Wash"
                Stretch="UniformToFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#59000000" />
                        <GradientStop Offset="0.55" Color="#A6000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid
            x:Name="ContentGrid"
            Padding="20,20,20,6"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TrackRow" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ArtFrame"
                    Width="72"
                    Height="72"
                    Background="#2C2C2E"
                    CornerRadius="16">
                    <Grid>
                        <FontIcon
                            x:Name="ArtFallback"
                            FontSize="26"
                            Glyph="&#xE8D6;" />
                        <Image x:Name="Art" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        x:Name="NowPlaying"
                        Style="{StaticResource IslandCaptionText}"
                        x:Uid="Island_NowPlaying" />
                    <TextBlock
                        x:Name="Title"
                        FontSize="17"
                        Style="{StaticResource IslandTitleText}" />
                    <TextBlock
                        x:Name="Artist"
                        MaxLines="1"
                        Style="{StaticResource IslandBodyText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <local:PlayingBars
                    x:Name="Bars"
                    Grid.Column="2"
                    Margin="0,4,0,0"
                    VerticalAlignment="Top" />
            </Grid>

            <Grid
                x:Name="SeekRow"
                Grid.Row="1"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="Elapsed"
                    MinWidth="34"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Typography.NumeralAlignment="Tabular" />
                <d:Scrubber x:Name="Track" Grid.Column="1" />
                <TextBlock
                    x:Name="Remaining"
                    Grid.Column="2"
                    MinWidth="34"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    TextAlignment="Right"
                    Typography.NumeralAlignment="Tabular" />
            </Grid>

            <StackPanel
                x:Name="ControlsRow"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="28">
                <Button
                    x:Name="PreviousButton"
                    Style="{StaticResource IslandGhostButtonStyle}"
                    x:Uid="Island_PreviousButton">
                    <FontIcon FontSize="18" Glyph="&#xF8AC;" />
                </Button>
                <Button
                    x:Name="PlayPauseButton"
                    Width="56"
                    Height="56"
                    Padding="0"
                    CornerRadius="28"
                    Style="{StaticResource IslandPrimaryButtonStyle}">
                    <FontIcon x:Name="PlayPauseGlyph" FontSize="20" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Style="{StaticResource IslandGhostButtonStyle}"
                    x:Uid="Island_NextButton">
                    <FontIcon FontSize="18" Glyph="&#xF8AD;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Nothing playing: say so, and how to get something here. -->
        <StackPanel
            x:Name="EmptyState"
            Padding="24,0"
            VerticalAlignment="Center"
            Spacing="8">
            <d:IconBadge
                x:Name="EmptyGlyph"
                HorizontalAlignment="Center"
                BadgeSize="52" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource IslandTitleText}"
                x:Uid="Island_NothingPlaying" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                Style="{StaticResource IslandBodyText}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                x:Uid="Island_NothingPlayingHint" />
        </StackPanel>
    </Grid>
</UserControl>
