<?xml version="1.0" encoding="utf-8"?>
<!--
    The music page: large art, the title and artist, a scrubber that thickens under the pointer, and the controls with
    a bright play button, over a two-tone glow in the album's colour.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.MediaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxKit.App.Modules.FluxIsland"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Modules/FluxIsland/IslandStyles.xaml" />
    </UserControl.Resources>
    <Grid>
        <!--
            Album colour pooling from the top left, and a deeper wash from the bottom right. The negative bottom margin
            lets the glow run on under the page dots, which the pill places below the page.
        -->
        <Rectangle
            x:Name="Glow"
            Margin="0,0,0,-18"
            IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush
                    Center="0.1,0.05"
                    GradientOrigin="0.1,0.05"
                    RadiusX="0.75"
                    RadiusY="1.4">
                    <GradientStop x:Name="GlowStart" Offset="0" Color="#668A84FF" />
                    <GradientStop Offset="1" Color="#008A84FF" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Margin="0,0,0,-18" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush
                    Center="1,1"
                    GradientOrigin="1,1"
                    RadiusX="0.7"
                    RadiusY="1.2">
                    <GradientStop x:Name="GlowEnd" Offset="0" Color="#338A84FF" />
                    <GradientStop Offset="1" Color="#008A84FF" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid
            x:Name="ContentGrid"
            Padding="20,18,20,6"
            RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TrackRow" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ArtFrame"
                    Width="64"
                    Height="64"
                    Background="#1A1A1F"
                    CornerRadius="14">
                    <Grid>
                        <FontIcon
                            x:Name="ArtFallback"
                            FontSize="24"
                            Glyph="&#xE8D6;" />
                        <Image x:Name="Art" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock x:Name="Title" Style="{StaticResource IslandTitleText}" FontSize="16" />
                    <TextBlock
                        x:Name="Artist"
                        FontSize="13"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <local:PlayingBars
                    x:Name="Bars"
                    Grid.Column="2"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top" />
            </Grid>

            <Grid
                x:Name="SeekRow"
                Grid.Row="1"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="Elapsed"
                    MinWidth="34"
                    VerticalAlignment="Center"
                    FontSize="11" />
                <Grid
                    x:Name="Track"
                    Grid.Column="1"
                    Height="18"
                    Background="Transparent">
                    <Border
                        x:Name="TrackBase"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="#2EFFFFFF"
                        CornerRadius="3" />
                    <Border
                        x:Name="TrackFill"
                        Width="0"
                        Height="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="3" />
                </Grid>
                <TextBlock
                    x:Name="Remaining"
                    Grid.Column="2"
                    MinWidth="34"
                    VerticalAlignment="Center"
                    FontSize="11"
                    TextAlignment="Right" />
            </Grid>

            <StackPanel
                x:Name="ControlsRow"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">
                <Button
                    x:Name="PreviousButton"
                    Style="{StaticResource IslandIconButtonStyle}"
                    x:Uid="Island_PreviousButton">
                    <FontIcon FontSize="16" Glyph="&#xE892;" />
                </Button>
                <Button
                    x:Name="PlayPauseButton"
                    Width="46"
                    Height="46"
                    CornerRadius="23"
                    Padding="0"
                    Style="{StaticResource IslandPrimaryButtonStyle}">
                    <FontIcon x:Name="PlayPauseGlyph" FontSize="18" Glyph="&#xE769;" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Style="{StaticResource IslandIconButtonStyle}"
                    x:Uid="Island_NextButton">
                    <FontIcon FontSize="16" Glyph="&#xE893;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Nothing playing: say so, and how to get something here. -->
        <StackPanel
            x:Name="EmptyState"
            Padding="24,0"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="Collapsed">
            <Border
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                Background="#1A1A1F"
                CornerRadius="14">
                <FontIcon x:Name="EmptyGlyph" FontSize="20" Glyph="&#xE8D6;" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                x:Uid="Island_NothingPlaying" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                FontSize="12"
                TextAlignment="Center"
                TextWrapping="Wrap"
                x:Uid="Island_NothingPlayingHint" />
        </StackPanel>
    </Grid>
</UserControl>
