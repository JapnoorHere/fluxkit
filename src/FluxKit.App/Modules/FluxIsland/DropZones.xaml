<?xml version="1.0" encoding="utf-8"?>
<!--
    What to do with files dragged onto the island: keep them on the shelf, copy their paths, zip them, or (for images)
    convert or shrink them. The zone under the pointer lights up; dropping there runs it.
-->
<UserControl
    x:Class="FluxKit.App.Modules.FluxIsland.DropZones"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Grid x:Name="ContentGrid" Padding="14,12,14,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="Heading"
            Margin="4,0,0,0"
            FontSize="12"
            x:Uid="Island_DropHeading" />
        <Grid
            x:Name="Zones"
            Grid.Row="1"
            ColumnSpacing="8" />
    </Grid>
</UserControl>
