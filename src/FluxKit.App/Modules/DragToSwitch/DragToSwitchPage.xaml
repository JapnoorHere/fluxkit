<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluxKit.App.Modules.DragToSwitch.DragToSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluxKit.App.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageMargin}" Spacing="{StaticResource SettingRowSpacing}">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Image Width="36" Height="36" Margin="0,0,0,24" Source="ms-appx:///Assets/DragToSwitch.png" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Drag-to-Switch" />
            </StackPanel>

            <!-- Hero: what the tool does, in one glance. -->
            <Border
                Margin="0,0,0,12"
                Padding="24,20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8A5;" />
                        <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE72A;" />
                        <Border Padding="8,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="18" Height="12" Background="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="2" />
                                <Border Width="18" Height="12" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                                <Border Width="18" Height="12" Background="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="2" />
                            </StackPanel>
                        </Border>
                        <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE72A;" />
                        <FontIcon FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7F4;" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Start dragging a file or a window, then hold it over a desktop in the picker. FluxKit takes you to that desktop so you can finish the drag there." TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Your drag is never interrupted. FluxKit doesn't copy, move or open your files." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <c:SettingRow Glyph="&#xE8AB;" Header="Turn on Drag-to-Switch">
                <ToggleSwitch x:Name="EnabledToggle" Toggled="OnEnabledToggled" />
            </c:SettingRow>
            <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="True" />

            <StackPanel x:Name="OptionsPanel" Spacing="{StaticResource SettingRowSpacing}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="What it reacts to" />
                <c:SettingRow Description="Choose when the desktop picker appears." Glyph="&#xE7C4;" Header="Show the picker">
                    <ComboBox x:Name="TriggerCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                        <ComboBoxItem Content="As soon as I start dragging" />
                        <ComboBoxItem Content="When I drag to the screen edge" />
                    </ComboBox>
                </c:SettingRow>
                <c:SettingRow Description="How long to hold over a desktop before FluxKit switches to it." Glyph="&#xE916;" Header="Hold time">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Grid Width="56" Height="4" VerticalAlignment="Center" Background="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="2">
                            <Rectangle x:Name="DwellPreview" HorizontalAlignment="Stretch" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="DwellPreviewScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Slider
                            x:Name="DelaySlider"
                            Width="200"
                            Maximum="1500"
                            Minimum="200"
                            StepFrequency="50"
                            TickFrequency="100"
                            ValueChanged="OnDelayChanged" />
                        <TextBlock x:Name="DelayText" MinWidth="64" VerticalAlignment="Center" />
                    </StackPanel>
                </c:SettingRow>
                <c:SettingRow x:Name="SourcesRow" Glyph="&#xEC50;" Header="Where file drags can start">
                    <ComboBox x:Name="SourcesCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                        <ComboBoxItem Content="File Explorer and the desktop" />
                        <ComboBoxItem Content="Any app" />
                    </ComboBox>
                </c:SettingRow>
                <c:SettingRow x:Name="MoveWindowsRow" Glyph="&#xE7C4;" Header="Move windows between desktops">
                    <ToggleSwitch x:Name="MoveWindowsToggle" Toggled="OnChanged" />
                </c:SettingRow>
                <c:SettingRow Description="While dragging, press 1–9 to go straight to that desktop." Glyph="&#xE765;" Header="Use number keys">
                    <ToggleSwitch x:Name="NumberKeysToggle" Toggled="OnChanged" />
                </c:SettingRow>
                <c:SettingRow Description="Shows a reminder that you can add a desktop with Ctrl+Win+D." Glyph="&#xE710;" Header="Show the picker when there's only one desktop">
                    <ToggleSwitch x:Name="SingleDesktopToggle" Toggled="OnChanged" />
                </c:SettingRow>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Look and feel" />
                <c:SettingRow Glyph="&#xE8A0;" Header="Position">
                    <ComboBox x:Name="PositionCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                        <ComboBoxItem Content="Bottom of the screen" />
                        <ComboBoxItem Content="Top of the screen" />
                        <ComboBoxItem Content="Next to the pointer" />
                    </ComboBox>
                </c:SettingRow>
                <c:SettingRow Glyph="&#xE740;" Header="Size">
                    <RadioButtons x:Name="SizeRadios" MaxColumns="2" SelectionChanged="OnChanged">
                        <x:String>Compact</x:String>
                        <x:String>Standard</x:String>
                    </RadioButtons>
                </c:SettingRow>
                <c:SettingRow Description="Show each desktop's wallpaper on its card, or only its name." Glyph="&#xE91B;" Header="Desktop previews">
                    <ComboBox x:Name="PreviewCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                        <ComboBoxItem Content="Wallpaper" />
                        <ComboBoxItem Content="Name only" />
                    </ComboBox>
                </c:SettingRow>
                <c:SettingRow Glyph="&#xE790;" Header="Picker theme">
                    <ComboBox x:Name="OverlayThemeCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                        <ComboBoxItem Content="Same as FluxKit" />
                        <ComboBoxItem Content="Same as Windows" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </c:SettingRow>
                <c:SettingRow x:Name="AnimationsRow" Glyph="&#xE8B1;" Header="Animations">
                    <ToggleSwitch x:Name="AnimationsToggle" Toggled="OnChanged" />
                </c:SettingRow>
                <c:SettingRow Description="Shows the picker for a few seconds with your current settings. Nothing is switched." Glyph="&#xE7B3;" Header="Try the picker">
                    <Button Click="OnPreview" Content="Show picker" />
                </c:SettingRow>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="After switching" />
                <c:SettingRow Description="Leaves a small bar on screen so you can switch again. Turn this off to hide the picker completely." Glyph="&#xE73F;" Header="Shrink the picker after switching">
                    <ToggleSwitch x:Name="CollapseToggle" Toggled="OnChanged" />
                </c:SettingRow>
                <c:SettingRow Description="If you press Esc after switching, FluxKit takes you back to the desktop where you started." Glyph="&#xE7A7;" Header="Go back when I cancel a drag">
                    <ToggleSwitch x:Name="ReturnToggle" Toggled="OnChanged" />
                </c:SettingRow>

                <Expander Margin="0,24,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Troubleshooting">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Virtual desktop support" />
                                <TextBlock x:Name="BackendText" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnRedetect" Content="Check again" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Desktops found" />
                            <TextBlock x:Name="DesktopsText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Last drag" />
                            <TextBlock x:Name="LastSessionText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnOpenLogs" Content="Open log folder" />
                            <Button x:Name="CopyDiagnosticsButton" Click="OnCopyDiagnostics" Content="Copy diagnostic info" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
