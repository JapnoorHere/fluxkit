<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluxKit.App.Modules.DragToSwitch.DragToSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluxKit.App.Controls"
    xmlns:local="using:FluxKit.App.Modules.DragToSwitch">
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Margin="32,24,20,0" RowSpacing="{StaticResource GroupSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader x:Name="Header" x:Uid="DragToSwitch_Header" Margin="0,0,12,0" IconAsset="DragToSwitch.png">
            <ToggleSwitch x:Name="EnabledToggle" x:Uid="DragToSwitch_Enabled" MinWidth="0" Toggled="OnEnabledToggled" />
        </c:PageHeader>

        <!-- Only for problems; the normal status lives in the header. -->
        <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="0,0,12,0" IsClosable="False" IsOpen="False" />

        <c:ToolPageLayout Grid.Row="2">
            <c:ToolPageLayout.Preview>
                <local:PickerPreview x:Name="Preview" TryRequested="OnPreviewRequested" />
            </c:ToolPageLayout.Preview>

            <StackPanel x:Name="OptionsPanel" Spacing="{StaticResource GroupSpacing}">
                <c:SettingsGroup x:Uid="DragToSwitch_BehaviourGroup">
                    <StackPanel>
                        <c:SettingRow x:Uid="DragToSwitch_Trigger" Glyph="&#xE7C4;">
                            <ComboBox x:Name="TriggerCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="DragToSwitch_TriggerStart" />
                                <ComboBoxItem x:Uid="DragToSwitch_TriggerEdge" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="DragToSwitch_HoldTime" Glyph="&#xE916;">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider
                                    x:Name="DelaySlider"
                                    Width="180"
                                    Maximum="1500"
                                    Minimum="200"
                                    StepFrequency="50"
                                    TickFrequency="100"
                                    ValueChanged="OnDelayChanged" />
                                <TextBlock x:Name="DelayText" MinWidth="56" VerticalAlignment="Center" />
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow x:Name="SourcesRow" x:Uid="DragToSwitch_Sources" Glyph="&#xEC50;">
                            <ComboBox x:Name="SourcesCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="DragToSwitch_SourcesExplorer" />
                                <ComboBoxItem x:Uid="DragToSwitch_SourcesAnyApp" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Name="MoveWindowsRow" x:Uid="DragToSwitch_MoveWindows" Glyph="&#xE7C4;">
                            <ToggleSwitch x:Name="MoveWindowsToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="DragToSwitch_NumberKeys" Glyph="&#xE765;">
                            <ToggleSwitch x:Name="NumberKeysToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="DragToSwitch_SingleDesktop" Glyph="&#xE710;">
                            <ToggleSwitch x:Name="SingleDesktopToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>

                <c:SettingsGroup x:Uid="DragToSwitch_AppearanceGroup">
                    <StackPanel>
                        <c:SettingRow x:Uid="DragToSwitch_Position" Glyph="&#xE8A0;">
                            <ComboBox x:Name="PositionCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="DragToSwitch_PositionBottom" />
                                <ComboBoxItem x:Uid="DragToSwitch_PositionTop" />
                                <ComboBoxItem x:Uid="DragToSwitch_PositionPointer" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="DragToSwitch_Size" Glyph="&#xE740;">
                            <ComboBox x:Name="SizeCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="DragToSwitch_SizeCompact" />
                                <ComboBoxItem x:Uid="DragToSwitch_SizeStandard" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="DragToSwitch_Previews" Glyph="&#xE91B;">
                            <ComboBox x:Name="PreviewCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="DragToSwitch_PreviewsWallpaper" />
                                <ComboBoxItem x:Uid="DragToSwitch_PreviewsName" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Uid="DragToSwitch_Theme" Glyph="&#xE790;">
                            <ComboBox x:Name="OverlayThemeCombo" SelectionChanged="OnChanged" Style="{StaticResource SettingComboStyle}">
                                <ComboBoxItem x:Uid="DragToSwitch_ThemeApp" />
                                <ComboBoxItem x:Uid="DragToSwitch_ThemeSystem" />
                                <ComboBoxItem x:Uid="DragToSwitch_ThemeLight" />
                                <ComboBoxItem x:Uid="DragToSwitch_ThemeDark" />
                            </ComboBox>
                        </c:SettingRow>
                        <c:SettingRow x:Name="AnimationsRow" x:Uid="DragToSwitch_Animations" Glyph="&#xE8B1;">
                            <ToggleSwitch x:Name="AnimationsToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>

                <c:SettingsGroup x:Uid="DragToSwitch_AfterGroup">
                    <StackPanel>
                        <c:SettingRow x:Uid="DragToSwitch_Collapse" Glyph="&#xE73F;">
                            <ToggleSwitch x:Name="CollapseToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                        <c:SettingRow x:Uid="DragToSwitch_Return" Glyph="&#xE7A7;">
                            <ToggleSwitch x:Name="ReturnToggle" Toggled="OnChanged" />
                        </c:SettingRow>
                    </StackPanel>
                </c:SettingsGroup>

                <Expander x:Uid="DragToSwitch_Troubleshooting" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Uid="DragToSwitch_BackendLabel" />
                                <TextBlock x:Name="BackendText" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <Button x:Uid="DragToSwitch_Redetect" Grid.Column="1" Click="OnRedetect" />
                        </Grid>
                        <StackPanel>
                            <TextBlock x:Uid="DragToSwitch_DesktopsLabel" />
                            <TextBlock x:Name="DesktopsText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Uid="DragToSwitch_LastDragLabel" />
                            <TextBlock x:Name="LastSessionText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="DragToSwitch_OpenLogs" Click="OnOpenLogs" />
                            <Button x:Name="CopyDiagnosticsButton" Click="OnCopyDiagnostics" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </c:ToolPageLayout>
    </Grid>
</Page>
