<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluxKit.App.Modules.DragToSwitch.SelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluxKit desktop selector">
    <!-- The drop target never accepts a drop (AcceptedOperation = None), so releasing here cannot move files. -->
    <Grid x:Name="Root" AllowDrop="True" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Grid.RenderTransform>

        <Grid x:Name="Expanded" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="4,0,4,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/FluxKit.png" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    x:Uid="Picker_AppName" />
                <TextBlock
                    x:Name="Instruction"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    x:Uid="Picker_Instruction"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="Hint"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    x:Uid="Picker_Hint" />
            </Grid>
            <StackPanel x:Name="CardsPanel" Grid.Row="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="12" />
        </Grid>

        <Grid x:Name="Pill" Padding="16,0" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/FluxKit.png" />
            <TextBlock x:Name="PillText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <FontIcon x:Name="PillChevron" Grid.Column="2" FontSize="12" Glyph="&#xE70E;" />
        </Grid>
    </Grid>
</Window>
