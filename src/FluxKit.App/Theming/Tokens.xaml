<?xml version="1.0" encoding="utf-8"?>
<!-- FluxKit layout tokens. Everything sits on a 4 px grid; use these instead of raw numbers. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="PageMargin">32,8,32,32</Thickness>
    <x:Double x:Key="PageMaxWidth">1120</x:Double>
    <x:Double x:Key="SettingRowSpacing">4</x:Double>
    <x:Double x:Key="GroupSpacing">16</x:Double>
    <x:Double x:Key="RailWidth">76</x:Double>
    <x:Double x:Key="ToolPreviewWidth">360</x:Double>
    <x:Double x:Key="ToolTileWidth">280</x:Double>
    <x:Double x:Key="ToolTileHeight">188</x:Double>
    <CornerRadius x:Key="GroupCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SquircleCornerRadius">12</CornerRadius>
    <Thickness x:Key="GroupHeaderPadding">20,16,20,4</Thickness>
    <Thickness x:Key="GroupedRowPadding">20,12</Thickness>
</ResourceDictionary>
